{
  "name": "article-site",
  "compatibility_date": "2026-09-27",
  "main": "./.output/server/index.mjs",
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "9051caef-e987-4a47-ae8c-2f91496b1a82",
      "database_name": "article-db"
    }
  ],
  "routes": [
    {
      "pattern": "www.wcbblll.cc",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}

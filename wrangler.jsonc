{
  "name": "article-site",
  "compatibility_date": "2026-09-27",
  "main": "./.output/server/index.mjs",
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS",
    // 未命中静态资源的请求一律交给 User Worker（Nuxt SSR）；
    // 不使用 "404-page"/"single-page-application"，避免 Asset Worker 把
    // Nuxt error.vue 返回的真实 404 状态码替换成 200 静态页（软 404）。
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "213282db-7a3a-490c-b653-964001df9109",
      "database_name": "article-site-db"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTICLES_R2",
      "bucket_name": "article-site-articles"
    }
  ],
  "vars": {
    "SITE_ID": "article-site"
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      { "name": "$DurableObject", "class_name": "$DurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["$DurableObject"] }
  ],
  "routes": [
    {
      "pattern": "www.wcbblll.cc",
      "custom_domain": true
    }
  ]
}

{
  "name": "article-site",
  "compatibility_date": "2026-09-27",
  "main": "./.output/server/index.mjs",
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS",
    // 未命中静态资源的请求一律交给 User Worker（Nuxt SSR）；
    // 不使用 "404-page"/"single-page-application"，避免 Asset Worker 把
    // Nuxt error.vue 返回的真实 404 状态码替换成 200 静态页（软 404）。
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "9051caef-e987-4a47-ae8c-2f91496b1a82",
      "database_name": "article-db"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "routes": [
    {
      "pattern": "www.wcbblll.cc",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
